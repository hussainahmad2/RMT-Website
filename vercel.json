{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.rmt-usa.com" }],
      "destination": "https://rmt-usa.com/",
      "permanent": true
    },
    {
      "source": "/:path((?!sitemap\\.xml$|robots\\.txt$).*)",
      "has": [{ "type": "host", "value": "www.rmt-usa.com" }],
      "destination": "https://rmt-usa.com/:path",
      "permanent": true
    },
    {
