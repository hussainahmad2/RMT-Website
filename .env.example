# EmailJS — create a free account at https://www.emailjs.com
# 1. Add an Email Service (Gmail / Outlook / custom SMTP)
# 2. Create email templates that send to {{to_email}} (hr@rmt-pk.com)
# 3. Copy Service ID, Public Key, and Template IDs below
#
# For Vercel production: Project Settings → Environment Variables
# Add every VITE_* variable below for Production + Preview, then Redeploy.
# Vite embeds these at build time — changing them requires a new deploy.
#
# File attachments (quote + career forms):
# - Requires an EmailJS paid plan (Personal or higher)
# - In each template → Attachments tab → Add Attachment → Variable Attachment
# - Add up to 3 slots with parameter names: attachment, attachment_2, attachment_3
# - Set Filename to {{attachment_name}}, {{attachment_2_name}}, {{attachment_3_name}}
# - Optional body field: {{attachments_list}} lists uploaded file names

VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
VITE_EMAILJS_TEMPLATE_QUOTE=your_quote_template_id
VITE_EMAILJS_TEMPLATE_CAREER=your_career_template_id
VITE_EMAILJS_TEMPLATE_CONTACT=your_contact_template_id

# Destination inbox for quote, career, and contact form submissions
VITE_FORM_TO_EMAIL=hr@rmt-pk.com
